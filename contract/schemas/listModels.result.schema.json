{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.webmcp.org/translator/contract/v1/listModels.result.schema.json",
  "title": "ListModelsResponse",
  "description": "Schema for listModels response in Direct Mode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "models"
  ],
  "properties": {
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Model identifier string returned by provider"
          }
        }
      }
    }
  }
}

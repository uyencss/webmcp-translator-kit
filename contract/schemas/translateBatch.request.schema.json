{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.webmcp.org/translator/contract/v1/translateBatch.request.schema.json",
  "title": "TranslateBatchRequest",
  "description": "Schema for translateBatch request payload in Direct Mode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "sourceLanguage",
    "targetLanguage",
    "model",
    "signal"
  ],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "documentId",
          "revision",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique identifier for the item within the batch"
          },
          "documentId": {
            "type": "string",
            "minLength": 1,
            "description": "Document or frame identifier for the text node"
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "description": "Revision number of the text node"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Source text to translate"
          },
          "context": {
            "type": "string",
            "description": "Optional surrounding context or DOM hint"
          }
        }
      }
    },
    "sourceLanguage": {
      "type": "string",
      "minLength": 2,
      "description": "Source language code (e.g. 'zh', 'en', or 'auto')"
    },
    "targetLanguage": {
      "type": "string",
      "minLength": 2,
      "description": "Target language code (e.g. 'vi')"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Pinned model identifier for the provider"
    },
    "signal": {
      "type": "object",
      "description": "Mandatory AbortSignal instance for lifecycle and timeout cancellation"
    }
  }
}

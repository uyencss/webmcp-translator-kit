{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.webmcp.org/translator/contract/v1/translateBatch.result.schema.json",
  "title": "TranslateBatchResponse",
  "description": "Schema for translateBatch response payload in Direct Mode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "results"
  ],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "revision",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Identifier matching the corresponding input item"
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "description": "Revision number matching the input item revision"
          },
          "text": {
            "type": "string",
            "description": "Translated text content for this item"
          }
        }
      }
    }
  }
}

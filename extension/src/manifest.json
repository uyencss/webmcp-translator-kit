{
  "manifest_version": 3,
  "name": "WebMCP Translator Kit",
  "version": "0.1.0",
  "description": "Direct mode translator extension calling 9router OpenAI-compatible endpoints",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WebMCP Translator"
  }
}

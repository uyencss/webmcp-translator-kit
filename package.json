{
  "name": "@gyga-browser/webmcp-translator-kit",
  "version": "0.1.2",
  "type": "module",
  "private": true,
  "exports": {
    "./contract": "./contract/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test 'test/**/*.test.mjs'",
    "test:smoke": "node scripts/build.mjs && node test/smoke/run.mjs",
    "test:smoke:real": "node scripts/build.mjs && node test/smoke/real.mjs",
    "check:contract": "node contract/check.mjs",
    "check:closure": "node scripts/check-closure.mjs",
    "check:layout": "node scripts/check-modal-overflow.mjs",
    "pack:ext": "node scripts/pack-ext.mjs",
    "pack:store": "node scripts/pack-store.mjs"
  }
}
